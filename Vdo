#include <stdio.h>

#ifdef _WIN32
#include <windows.h>
void esperar(int segundos) {
    Sleep(segundos * 1000);
}
#else
#include <unistd.h>
void esperar(int segundos) {
    sleep(segundos);
}
#endif

int main() {

    printf("Erro 404: arquivo nao encontrado\n");
    fflush(stdout);

    esperar(10);

    printf("\nLoading");
    fflush(stdout);

    for (int i = 0; i < 5; i++) {
        esperar(1);
        printf(".");
        fflush(stdout);
    }

    printf("\n\nAbrindo arquivo...\n");
    fflush(stdout);

    return 0;
}
